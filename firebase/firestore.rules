rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Xác thực Admin bằng Custom Claim 'admin == true', kèm fallback email trong giai đoạn chuyển đổi
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "haingxua@gmail.com"
      );
    }

    // 1. BẢNG XẾP HẠNG TỔNG HỢP TOÀN HỆ THỐNG (HIHI STUDY)
    // Đọc công khai phục vụ Leaderboard
    // Ghi: Chỉ chính chủ, kiểm soát chặt chẽ schema, kiểu dữ liệu, độ dài và giới hạn điểm số
    match /hihi_leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
                   // Không cho phép đổi uid khác auth.uid
                   && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
                   // Validate total_score (nếu có): số không âm, tối đa 10,000,000 (chống hack điểm)
                   && (!('total_score' in request.resource.data) || (request.resource.data.total_score is number && request.resource.data.total_score >= 0 && request.resource.data.total_score <= 10000000))
                   // Validate tên hiển thị: string, độ dài tối đa 100 ký tự
                   && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
                   // Validate wpm: số không âm, tối đa 350
                   && (!('wpm' in request.resource.data) || (request.resource.data.wpm is number && request.resource.data.wpm >= 0 && request.resource.data.wpm <= 350))
                   // Validate accuracy: số từ 0 đến 100
                   && (!('acc' in request.resource.data) || (request.resource.data.acc is number && request.resource.data.acc >= 0 && request.resource.data.acc <= 100))
                   // Validate words_learned: số không âm
                   && (!('words_learned' in request.resource.data) || (request.resource.data.words_learned is number && request.resource.data.words_learned >= 0))
                   // Validate streak: số không âm
                   && (!('streak' in request.resource.data) || (request.resource.data.streak is number && request.resource.data.streak >= 0));
    }

    // 2. BẢNG XẾP HẠNG CŨ CỦA TỪ VỰNG (Giữ tương thích ngược)
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10000000));
    }

    // 3. CHỦ ĐỀ TỪ VỰNG TÙY CHỈNH (CUSTOM TOPICS)
    // Đọc công khai để học viên tải về học
    // Ghi: Chỉ tài khoản có Custom Claim admin == true (hoặc email admin fallback) và hợp lệ schema
    match /hihi_custom_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                   && request.resource.data.lang is string && request.resource.data.lang.size() >= 2 && request.resource.data.lang.size() <= 10
                   && request.resource.data.words is list && request.resource.data.words.size() > 0 && request.resource.data.words.size() <= 500;
    }

    // 4. DỮ LIỆU CÁ NHÂN BẤM HUYỆT (Huyệt cá nhân, bộ kết hợp, điểm danh)
    match /acupoints/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    match /combos/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    match /attendance/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    // 5. HỒ SƠ VÀ THÀNH TÍCH CHUỖI HỌC (Streak Profiles)
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && (!('streak' in request.resource.data) || (request.resource.data.streak is number && request.resource.data.streak >= 0 && request.resource.data.streak <= 5000));
    }

    // Chặn toàn bộ các document/collection khác ngoài danh mục cho phép
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
