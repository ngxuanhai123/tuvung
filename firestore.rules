rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function validScore(v) {
      return v is number && v >= 0 && v <= 10000000;
    }

    function validOptionalScore(data, field) {
      return !(field in data) || validScore(data[field]);
    }

    function validPhotoUrl(data) {
      return !('photoURL' in data) || (
        data.photoURL is string &&
        data.photoURL.size() <= 1000 &&
        (data.photoURL.size() == 0 || data.photoURL.matches('^https://.*'))
      );
    }

    // Xác thực Admin bằng Custom Claim 'admin == true' hoặc email ĐÃ XÁC MINH
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true && request.auth.token.email == "haingxua@gmail.com")
      );
    }

    // 1. BẢNG XẾP HẠNG TỔNG HỢP TOÀN HỆ THỐNG (HIHI STUDY)
    match /hihi_leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
                   && validOptionalScore(request.resource.data, 'total_score')
                   && validOptionalScore(request.resource.data, 'tuvung_score')
                   && validOptionalScore(request.resource.data, 'chinhta_score')
                   && validOptionalScore(request.resource.data, 'dich_score')
                   && validOptionalScore(request.resource.data, 'week_score')
                   && validOptionalScore(request.resource.data, 'month_score')
                   && validOptionalScore(request.resource.data, 'week_tuvung')
                   && validOptionalScore(request.resource.data, 'week_chinhta')
                   && validOptionalScore(request.resource.data, 'week_dich')
                   && validOptionalScore(request.resource.data, 'month_tuvung')
                   && validOptionalScore(request.resource.data, 'month_chinhta')
                   && validOptionalScore(request.resource.data, 'month_dich')
                   && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
                   && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
                   && validPhotoUrl(request.resource.data)
                   && (!('wpm' in request.resource.data) || (request.resource.data.wpm is number && request.resource.data.wpm >= 0 && request.resource.data.wpm <= 350))
                   && (!('acc' in request.resource.data) || (request.resource.data.acc is number && request.resource.data.acc >= 0 && request.resource.data.acc <= 100))
                   && (!('words_learned' in request.resource.data) || (request.resource.data.words_learned is number && request.resource.data.words_learned >= 0 && request.resource.data.words_learned <= 1000000))
                   && (!('streak' in request.resource.data) || (request.resource.data.streak is number && request.resource.data.streak >= 0 && request.resource.data.streak <= 5000))
                   && (!('streak_days' in request.resource.data) || (request.resource.data.streak_days is number && request.resource.data.streak_days >= 0 && request.resource.data.streak_days <= 5000));
    }

    // 2. BẢNG XẾP HẠNG CŨ CỦA TỪ VỰNG
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && validOptionalScore(request.resource.data, 'score')
                   && validOptionalScore(request.resource.data, 'score_en')
                   && validOptionalScore(request.resource.data, 'score_id')
                   && validOptionalScore(request.resource.data, 'score_week_en')
                   && validOptionalScore(request.resource.data, 'score_month_en')
                   && validOptionalScore(request.resource.data, 'score_week_id')
                   && validOptionalScore(request.resource.data, 'score_month_id')
                   && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
                   && validPhotoUrl(request.resource.data);
    }

    // 3. CHỦ ĐỀ TỪ VỰNG TÙY CHỈNH (CUSTOM TOPICS)
    match /hihi_custom_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                   && request.resource.data.lang is string && request.resource.data.lang.size() >= 2 && request.resource.data.lang.size() <= 10
                   && request.resource.data.words is list && request.resource.data.words.size() > 0 && request.resource.data.words.size() <= 500;
    }

    // 4. DỮ LIỆU CÁ NHÂN BẤM HUYỆT
    match /acupoints/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    match /combos/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    match /attendance/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    // 5. HỒ SƠ VÀ THÀNH TÍCH CHUỖI HỌC (Streak Profiles)
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && (!('streak' in request.resource.data) || (request.resource.data.streak is number && request.resource.data.streak >= 0 && request.resource.data.streak <= 5000))
                   && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
                   && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
                   && validPhotoUrl(request.resource.data);
    }

    // Chặn toàn bộ các document/collection khác ngoài danh mục cho phép
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
