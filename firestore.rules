rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. BẢNG XẾP HẠNG TỔNG HỢP TOÀN HỆ THỐNG (HIHI STUDY)
    // Mọi người đều có thể đọc công khai bảng xếp hạng
    // Người dùng đăng nhập được ghi nhận và cập nhật điểm cho chính tài khoản của mình
    match /hihi_leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (!('total_score' in request.resource.data) || (request.resource.data.total_score is number && request.resource.data.total_score >= 0));
    }

    // 2. BẢNG XẾP HẠNG CŨ CỦA TỪ VỰNG (Giữ tương thích ngược)
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 3. CHỦ ĐỀ TỪ VỰNG TÙY CHỈNH (CUSTOM TOPICS)
    // Mọi người đều có thể tải về học
    // Chỉ Admin haingxua@gmail.com mới có quyền tạo, sửa và xóa chủ đề
    match /hihi_custom_topics/{topicId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "haingxua@gmail.com";
    }

    // 4. DỮ LIỆU CÁ NHÂN BẤM HUYỆT (Huyệt cá nhân, bộ kết hợp, điểm danh)
    match /acupoints/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /combos/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /attendance/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 5. HỒ SƠ VÀ THÀNH TÍCH CHUỖI HỌC (Streak Profiles)
    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
